{
  "name": "xiaochu-order-server",
  "version": "1.0.0",
  "private": true,
  "description": "小厨点餐 H5 API 服务（Node.js + Express + TypeScript）",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && npm --prefix ../web install --include=dev --no-audit --no-fund && npm --prefix ../web run build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "express": "4.19.2",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "@supabase/supabase-js": "2.45.4",
    "undici": "5.28.4"
  },
  "devDependencies": {
    "typescript": "5.3.3",
    "ts-node-dev": "2.0.0",
    "@types/express": "4.17.21",
    "@types/cors": "2.8.17",
    "@types/node": "16.18.11"
  }
}
